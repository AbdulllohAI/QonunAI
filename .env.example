# ============================================================================
# HuquqAI — copy to .env and fill in.  `cp .env.example .env`
# ============================================================================

# --- app --------------------------------------------------------------------
ENV=dev
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
CORS_ORIGINS=http://localhost:3000

# --- ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- database ---------------------------------------------------------------
POSTGRES_PASSWORD=uzlex
POSTGRES_DSN=postgresql+asyncpg://uzlex:uzlex@localhost:5432/uzlex
REDIS_DSN=redis://localhost:6379/0

# --- LLM --------------------------------------------------------------------
# anthropic | openai | ollama   (switchable per request via the `provider` field)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — higher spends more tokens on reasoning.
ANTHROPIC_EFFORT=high

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set for vLLM / Together / any OpenAI-compatible gateway.
OPENAI_BASE_URL=

# Local model. Pull it first:  ollama pull llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Raise this for a generous-tier provider (paid Anthropic/OpenAI, higher Groq
# tier); some free tiers count prompt + this reserved output budget against a
# per-minute token limit, so an overly large default can 413 on its own.
LLM_MAX_TOKENS=3000

# --- embeddings / retrieval -------------------------------------------------
# bge-m3 is multilingual and handles uz/ru/en in one vector space.
# Changing this REQUIRES a full reindex (POST /api/v1/admin/reindex).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu          # cuda for GPU
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# --- GPU (optional) ----------------------------------------------------------
# For EMBEDDING_DEVICE=cuda above, also needed:
#   - NVIDIA Container Toolkit on the host + the backend service's GPU device
#     reservation in docker-compose.yml (already present there).
#   - TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124 (or whichever
#     CUDA build matches your driver) so the backend image installs a
#     CUDA-enabled torch instead of the CPU-only default.
#   - UVICORN_WORKERS=1, so the embedder + reranker aren't loaded onto the
#     GPU twice by two separate worker processes.
# worker/beat deliberately stay CPU-only regardless (see docker-compose.yml)
# — background ingestion isn't latency-critical, and a single consumer GPU
# usually can't fit two full copies of both models comfortably.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# UVICORN_WORKERS=1

# pgvector (default) | faiss | chroma
VECTOR_BACKEND=pgvector

RETRIEVAL_TOP_K_DENSE=40
RETRIEVAL_TOP_K_SPARSE=40
RETRIEVAL_TOP_K_FINAL=12
MIN_RELEVANCE_SCORE=0.25

# --- ingestion --------------------------------------------------------------
LEXUZ_BASE_URL=https://lex.uz
# Only if you have an access agreement with the Ministry of Justice.
LEXUZ_API_BASE=
NORMA_BASE_URL=https://norma.uz
GOV_OPENDATA_BASE=https://data.egov.uz/apiPartner
GOV_OPENDATA_TOKEN=

# Identify yourself honestly and keep the rate limit conservative.
INGEST_USER_AGENT=HuquqAI/1.0 (+legal-research; contact: you@example.uz)
INGEST_RATE_LIMIT_RPS=2.0
INGEST_CONCURRENCY=4

# --- limits -----------------------------------------------------------------
RATE_LIMIT_ANON_PER_HOUR=20
RATE_LIMIT_USER_PER_HOUR=200
MAX_UPLOAD_MB=25

# --- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
